# ==========================================================================
#  Cyber Security Employee Dashboard - settings
#  Edit a value, save, then restart the server (close its window and run
#  StartDashboard.exe or launcher.py again).
#  Lines starting with # are ignored. Real environment variables override
#  anything set here. This file holds the admin secret: never share or commit it.
# ==========================================================================

# Port the app listens on. Leaderboard: http://localhost:<PORT>/
PORT=8000

# Who can reach the app:
#   127.0.0.1 = only this computer
#   0.0.0.0   = other computers on the network (allow the port in the firewall,
#               and put an HTTPS reverse proxy in front - see README)
HOST=127.0.0.1

# ---- Admin console --------------------------------------------------------
# The admin console opens at:
#     http://localhost:<PORT>/<ADMIN_PATH_PREFIX>/<ADMIN_SECRET>/
# Anyone with this URL has full admin rights, so keep ADMIN_SECRET long and random.
# Change either value and restart to move the console; the old URL stops working.
# Fresh random secret written here:  .venv\Scripts\python scripts\admin_url.py --rotate

# First part of the path: letters, digits, - or _ (can't be "api" or "static").
ADMIN_PATH_PREFIX=ops

# Secret part: 24-128 characters of A-Z a-z 0-9 _ -
# Left empty here on purpose: the launcher copies this file to .env on first run
# and fills in a freshly generated random secret.
ADMIN_SECRET=

# Optional second factor (recommended when HOST is not 127.0.0.1): the browser
# also asks for this password (any username). At least 12 characters.
# 10 wrong attempts from one address lock it out for 15 minutes.
# ADMIN_PASSWORD=

# ---- Optional (remove the # to use) --------------------------------------

# Address people use to reach the app; only used for the URLs printed at startup.
# PUBLIC_URL=https://cyber.example.com

# Replaces "CYBER" in the top-left brand.
# ORG_NAME=Acme

# Text in the small badge above the title.
# DASHBOARD_TAGLINE=Cyber Security Awareness Month · Oct 2026

# Largest Excel file the admin console accepts, in MB (1-500).
# MAX_UPLOAD_MB=25

# Folder for scores, archived uploads, backups and the audit log (relative to this folder).
# DATA_DIR=data

# Set to 1 ONLY when a reverse proxy sits in front of the app. The app then takes the
# client address and https scheme from the proxy's X-Forwarded-For / -Proto headers.
# TRUST_PROXY=1

# Print the full admin URL at startup even when output goes to a log file (default: console only).
# SHOW_ADMIN_URL=1
